# Server-only. Do not prefix secrets with NEXT_PUBLIC_.
# Unset NEXORA_DEPLOYMENT_MODE keeps certified local behavior.

# NEXORA_DEPLOYMENT_MODE=local
# NEXORA_DEPLOYMENT_MODE=hosted

# Required for a real session signature.
# NEXTAUTH_SECRET=

# Production must be an https origin that is not localhost.
# NEXTAUTH_URL=https://example.invalid

# Production provider. Ignored while the development sign-in flag is on.
# GITHUB_ID=
# GITHUB_SECRET=

# Development/test seam. A production https origin ignores this flag.
# A local http://127.0.0.1 or http://localhost origin may use it.
# NEXORA_AUTH_DEV_SIGN_IN=true
# NEXORA_AUTH_DEV_USER_IDS=user_a,user_b

# Development directory database. Production Hosted mode ignores this and
# requires DATABASE_URL. A missing production database fails closed.
# NEXORA_DATABASE_DIR=

# Production Postgres connection string. Server-only. Never NEXT_PUBLIC_.
# DATABASE_URL=

# Server-only secret Next uses when forwarding an authorized LLM call.
# Hosted FastAPI rejects /nexora/llm/runtime without this same value.
# NEXORA_LLM_GATEWAY_SECRET=

# Required in Hosted production. Use the Render private-service origin and
# never prefix this with NEXT_PUBLIC_.
# NEXORA_PRIVATE_API_BASE=
