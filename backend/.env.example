# Nexora Backend Environment

# Application
APP_ENV=development
APP_NAME=nexora
APP_VERSION=dev

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Connection
FRONTEND_URL=http://localhost:3000

# AI Provider
# OPENAI_API_KEY should be set to a real provider key in backend/.env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM-MVP:4 usage policy (server-only). Missing/false → paid LLM is not authorized.
# This is a technical MVP default, not a commercial plan.
NEXORA_LLM_ENABLED=false
NEXORA_LLM_USAGE_LIMIT=0
NEXORA_LLM_USAGE_PERIOD=daily
NEXORA_LLM_USAGE_SCOPE=ws_default


# Nexora Simulation Engine
NEXORA_MODE=business
NEXORA_DEBUG=true

# Logging
LOG_LEVEL=info

# Security
# JWT_SECRET must be set to a strong secret value in backend/.env only.
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# Storage
# DATA_DIR is the local base directory for backend runtime data.
DATA_DIR=./data
REPLAY_STORAGE=./data/replays
MEMORY_STORAGE=./data/memory

# Feature Flags
ENABLE_FRAGILITY_ENGINE=true
ENABLE_MEMORY_ENGINE=true
ENABLE_STRATEGIC_ENGINE=true
